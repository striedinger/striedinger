{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y",
    "nextjs",
    "vitest",
    "promise"
  ],
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-no-constructed-context-values": "off",
    "react/jsx-key": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "unicorn/require-post-message-target-origin": "off",
    "nextjs/no-img-element": "error",
    "react-hooks-js/static-components": "error",
    "react-hooks-js/use-memo": "error",
    "react-hooks-js/preserve-manual-memoization": "error",
    "react-hooks-js/incompatible-library": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/globals": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/set-state-in-effect": "error",
    "react-hooks-js/error-boundaries": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/unsupported-syntax": "error",
    "react-hooks-js/config": "error",
    "react-hooks-js/gating": "error",
    "tailwindcss/no-unknown-classes": "error",
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/no-unnecessary-arbitrary-value": "error",
    "tailwindcss/prefer-theme-tokens": "error",
    "tailwindcss/no-hardcoded-colors": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "^(?:\\S+:)?(?:-?(?:p|m)[trblxyse]?|gap(?:-[xy])?|size|[hw]|min-[hw]|max-[hw]|inset(?:-[xy])?|top|right|bottom|left|start|end|-?translate-[xy]|space-[xy]|basis)-\\[\\d+(?:\\.\\d+)?(?:px|rem)\\]$",
            "message": "use the spacing scale, such as h-13 for 52px or size-5.5 for 22px"
          },
          {
            "pattern": "^(?:\\S+:)?(?:pt|pb|mt|mb|top|bottom)-\\[(?:max\\(env\\(safe-area-inset-(?:top|bottom)\\),\\d+px\\)|calc\\(\\d+(?:\\.\\d+)?rem\\+env\\(safe-area-inset-top\\)\\)|calc\\(env\\(safe-area-inset-bottom\\)\\+\\d+(?:\\.\\d+)?rem\\)|env\\(safe-area-inset-(?:top|bottom)\\))\\]$",
            "message": "use the safe-area utilities from ios-utilities.css, such as pb-safe-min-3.5 or pt-safe-plus-16"
          },
          {
            "pattern": "^(?:\\S+:)?text-\\[(?:11|12|13|15|16|17|20|22|28|34)px\\]$",
            "message": "use an iOS text style, such as text-ios-body or text-ios-footnote"
          },
          {
            "pattern": "ease-\\[cubic-bezier\\(0\\.32,0\\.72,0,1\\)\\]",
            "message": "use ease-ios"
          }
        ]
      }
    ],
    "eslint/max-classes-per-file": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-negated-condition": "off",
    "eslint/require-unicode-regexp": "off",
    "eslint/require-await": "off",
    "import/max-dependencies": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "unicorn/escape-case": "off",
    "unicorn/explicit-length-check": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-dom-node-dataset": "off",
    "unicorn/prefer-query-selector": "off",
    "unicorn/prefer-string-replace-all": "off",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableString": true,
        "allowNullableBoolean": true,
        "allowAny": false,
        "allowNullableNumber": false,
        "allowNullableObject": true
      }
    ],
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "eslint/no-console": "error",
    "eslint/no-eq-null": "error",
    "eslint/no-alert": "error",
    "eslint/no-var": "error",
    "eslint/no-shadow": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "unicorn/no-document-cookie": "error"
  },
  "settings": {
    "next": {
      "rootDir": "apps/web/"
    },
    "react": {
      "linkComponents": [
        {
          "name": "Link",
          "linkAttribute": "href"
        }
      ]
    },
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    },
    "tailwindcss": {
      "entryPoint": "apps/web/components/ios/ios-utilities.css",
      "callees": ["cn"],
      "rootFontSize": 16
    }
  },
  "ignorePatterns": [
    ".agents/**",
    "**/.next/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "overrides": [
    {
      "files": [
        "apps/web/app/*/mta/station-card.tsx",
        "apps/web/app/*/og/metadata-table.tsx",
        "apps/web/app/*/sudoku/sudoku-board.tsx"
      ],
      "rules": {
        "react/no-array-index-key": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/image.tsx"],
      "rules": {
        "nextjs/no-img-element": "off"
      }
    },
    {
      "files": ["apps/web/scripts/assets/avif-codec-worker.js"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["apps/web/scripts/**", ".github/scripts/**"],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "react-hooks-js",
      "specifier": "eslint-plugin-react-hooks"
    },
    "oxlint-tailwindcss"
  ]
}
