{
  "name": "striedinger",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "turbo run format:check comments oxlint typecheck test knip",
    "comments": "node scripts/check-comments.mts",
    "comments:fix": "node scripts/check-comments.mts --fix",
    "dev": "turbo dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files --format",
    "lint": "turbo run oxlint",
    "lint:fix": "pnpm --filter web typegen && oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "oxlint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxc-parser": "0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "pnpm@12.15.0"
}
