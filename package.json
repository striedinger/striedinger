{
  "name": "striedinger",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check": "turbo run format:check comments oxlint typecheck test knip",
    "comments": "node scripts/check-comments.mts",
    "comments:fix": "node scripts/check-comments.mts --fix",
    "dev": "turbo dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "knip:fix": "knip --fix --allow-remove-files --format",
    "lint": "turbo run oxlint",
    "lint:fix": "pnpm --filter web typegen && oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "oxlint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "knip": "^6.48.0",
    "oxc-parser": "0.160.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tailwindcss": "^1.17.2",
    "oxlint-tsgolint": "^7.0.2008",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "turbo": "^2.11.13",
    "typescript": "7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.23.0"
}
